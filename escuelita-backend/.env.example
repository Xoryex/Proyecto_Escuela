# URL de la base de datos MySQL (por defecto usa el puerto 3307)
DB_URL=jdbc:mysql://localhost:3307/Escuela?createDatabaseIfNotExist=true

# Usuario de la base de datos
DB_USERNAME=root

# Contraseña de la base de datos
DB_PASSWORD=

# Seguridad JWT (cambiar en producción por clave de >= 64 caracteres)
JWT_SECRET=CAMBIAR_POR_CLAVE_SECRETA_SEGURA_DE_64_CARACTERES_MINIMO
JWT_EXPIRATION_MS=604800000

# API Decolecta RENIEC
DECOLECTA_API_URL=https://api.decolecta.com/v1
DECOLECTA_API_TOKEN=TU_TOKEN_DECOLECTA_AQUI
